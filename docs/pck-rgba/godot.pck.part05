void fragment(){
	//Coords
	vec2 uv =  FRAGCOORD.xy / (1.0 / SCREEN_PIXEL_SIZE).xy;
	
	//Produce some noise based on the coords
	vec3 grainPlate = vec3(grain(uv, TIME));
	
